NODE_ENV=development
LOG_LEVEL=debug
APP_NAME=ai-transformation-workshop-poll-app

# SQLite file-based database. Created automatically on first run.
DATABASE_URL=file:./local.db

# Admin dashboard password (used by verifyAdminPassword). Leave unset locally;
# required only if/when an admin login flow is wired up to this helper.
ADMIN_DASHBOARD_PASSWORD=
